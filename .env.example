# Copy this file to .env.local (which is git-ignored) and fill in the values.
# Supabase dashboard → Project Settings → API Keys.
# Only the PUBLISHABLE key goes here — never the secret / service-role key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
